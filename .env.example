# Copia este fichero a .env y rellena los valores. .env está en .gitignore: nunca lo subas.
# Ninguna variable es obligatoria para ejecutar los tests ni los mundos.

# Directorio de salidas de ejecución (logs, linajes, bases de datos, CSV).
# Por defecto: ./salidas en la raíz del repositorio.
IDA_OUT_DIR=

# Ruta al ejecutable de Stockfish (opcional; solo para el mundo de ajedrez con --elo).
IDA_STOCKFISH_PATH=

# Solo para el servicio opcional nivel_0_demiurgo (PostgreSQL + pgvector, preparado, no conectado).
POSTGRES_USER=demiurgo
POSTGRES_PASSWORD=
POSTGRES_DB=ida_inconsciente_colectivo
