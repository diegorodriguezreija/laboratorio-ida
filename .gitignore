# Bytecode y cachés
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# Entornos virtuales
.venv/
venv/
env/

# Secretos y configuración local
.env
.env.*
!.env.example
*.pem
*.key

# Salidas de ejecución (se conservan los datasets CSV y resúmenes JSON; se ignoran archivos pesados/temporales)
salidas/*
!salidas/*/
!salidas/*/*.csv
!salidas/*/*.json

# Binarios externos (Stockfish GPL-3.0, no se redistribuye)
bin/
*.exe

# Bases de datos y logs locales
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log

# Material privado del autor (nunca en el repositorio)
libro_profesor*
INVENTARIO.md
INFORME_FINAL.md

# IDE
.vscode/
.idea/
